source "https://rubygems.org"

# bulma-clean-theme 1.x needs Jekyll >= 4.3 (dart sass). GitHub Pages
# classic builds stay on Jekyll 3.9, so docs deploy via Actions.
gem "jekyll", "~> 4.3"
gem "bulma-clean-theme", "~> 1.3"
gem "webrick"
gem "rubyzip", ">= 3.4.0"

group :jekyll_plugins do
  gem "jekyll-feed", "~> 0.15"
end

platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", "~> 2.0"
  gem "tzinfo-data"
end

gem "wdm", "~> 0.2.0", :platforms => [:mingw, :x64_mingw, :mswin]
